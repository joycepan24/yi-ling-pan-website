---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import homepagePortrait from '../assets/images/homepage-portrait.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';

const latestArticles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt!.valueOf() - a.data.publishedAt!.valueOf())
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat('en', {
  dateStyle: 'long',
  timeZone: 'UTC',
});

const focusAreas = [
  {
    title: 'Teaching Reflections',
    description: 'Classroom observations, teaching experiences, and questions that shape my practice.',
  },
  {
    title: 'Theory & Practice',
    description: 'Connecting ideas about pedagogy, language, and learning with classroom experience.',
  },
  {
    title: 'Teaching Resources',
    description: 'Materials, activities, and teaching ideas created, adapted, or used in the classroom.',
  },
];
---

<BaseLayout
  title="Bilingual educator"
  description="Yi Ling Pan is a bilingual educator sharing teaching reflections, theory and practice, and teaching resources."
>
  <section class="intro site-shell" aria-labelledby="page-title">
    <p class="eyebrow">Bilingual educator</p>
    <h1 id="page-title">Helping learners bring language into everyday life.</h1>
    <figure class="intro-portrait">
      <Image
        src={homepagePortrait}
        alt="Portrait of Yi Ling Pan seated outdoors."
        width="1536"
        height="2729"
      />
    </figure>
  </section>

  <section class="focus-section site-shell" aria-label="Focus areas">
    <ol class="focus-list">
      {focusAreas.map((area, index) => (
        <li>
          <p class="focus-number" aria-hidden="true">0{index + 1}</p>
          <h2>{area.title}</h2>
          <p>{area.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="latest-writing site-shell" aria-labelledby="latest-writing-title">
    <header class="latest-writing__header">
      <h2 id="latest-writing-title">Latest Writing</h2>
      <a href="/articles/">View all writing <span aria-hidden="true">→</span></a>
    </header>

    <ol class="latest-writing__list">
      {latestArticles.map((article) => (
        <li lang={article.data.language}>
          <p class="latest-writing__date">
            <time datetime={article.data.publishedAt!.toISOString()}>
              {dateFormatter.format(article.data.publishedAt!)}
            </time>
          </p>
          <div>
            <h3><a href={`/articles/${article.data.slug}/`}>{article.data.title}</a></h3>
            <p>{article.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
