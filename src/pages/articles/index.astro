---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.publishedAt!.valueOf() - a.data.publishedAt!.valueOf());

const [featuredArticle, ...archiveArticles] = articles;

const dateFormatter = new Intl.DateTimeFormat('en', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
---

<BaseLayout title="Writing" description="Articles and reflections by Yi Ling Pan.">
  <section class="writing-index site-shell" aria-labelledby="page-title">
    <header class="page-heading">
      <p class="eyebrow">Writing</p>
      <h1 id="page-title">Writing</h1>
      <span class="writing-index__shape writing-index__shape--one" aria-hidden="true"></span>
      <span class="writing-index__shape writing-index__shape--two" aria-hidden="true"></span>
      <span class="writing-index__shape writing-index__shape--three" aria-hidden="true"></span>
    </header>

    {featuredArticle && (
      <section
        class="writing-featured"
        aria-labelledby="featured-essay-title"
        lang={featuredArticle.data.language}
      >
        <p class="article-date">
          <time datetime={featuredArticle.data.publishedAt!.toISOString()}>
            {dateFormatter.format(featuredArticle.data.publishedAt!)}
          </time>
        </p>
        <h2 id="featured-essay-title">
          <a href={`/articles/${featuredArticle.data.slug}/`}>{featuredArticle.data.title}</a>
        </h2>
        <p class="writing-featured__description">{featuredArticle.data.description}</p>
        <a class="writing-featured__link" href={`/articles/${featuredArticle.data.slug}/`}>
          Read essay <span aria-hidden="true">⟶</span>
        </a>
      </section>
    )}

    <ol class="article-list article-list--compact">
      {archiveArticles.map((article) => (
        <li lang={article.data.language}>
          <p class="article-date">
            <time datetime={article.data.publishedAt!.toISOString()}>
              {dateFormatter.format(article.data.publishedAt!)}
            </time>
          </p>
          <div>
            <h2><a href={`/articles/${article.data.slug}/`}>{article.data.title}</a></h2>
            <p>{article.data.description}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="writing-index__closure" aria-hidden="true"></div>
  </section>
</BaseLayout>
